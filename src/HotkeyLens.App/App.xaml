<Application x:Class="HotkeyLens.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HotkeyLens.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:EmptyTextToVisibilityConverter x:Key="EmptyTextToVisibility" />
            <converters:PercentWidthConverter x:Key="PercentWidth" />
            <converters:ApplicationIconConverter x:Key="ApplicationIcon" />
        </ResourceDictionary>
    </Application.Resources>
</Application>