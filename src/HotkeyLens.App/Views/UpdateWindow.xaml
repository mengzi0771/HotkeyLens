<Window x:Class="HotkeyLens.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotkeyLens 更新"
        Width="640" Height="620"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="发现新版本" Style="{StaticResource SectionTitle}" FontSize="20" />
            <TextBlock Text="{Binding ReleaseName}" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,13" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="当前版本" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding CurrentVersionText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="15" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="最新版本" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding LatestVersionText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="15"
                               Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PublishedText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ModeLabel, StringFormat=当前为{0}}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,13" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="更新说明" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6" Padding="12,9"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DownloadProgress, StringFormat=正在下载并校验… {0:F0}%}"
                               Style="{StaticResource CaptionText}" />
                    <ProgressBar Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding DownloadProgress}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource EmptyTextToVisibility}}" />
            <TextBlock Text="{Binding LastCheckedText, StringFormat=上次检查：{0}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
            <TextBlock Text="下载通过 HTTPS 进行，并校验 SHA256SUMS.txt 中的 SHA256；校验失败会拒绝执行。SHA256 不能单独证明发布者身份。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="打开发布页" Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="打开下载位置" Command="{Binding OpenDownloadFolderCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="稍后提醒" Command="{Binding RemindLaterCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="跳过此版本" Command="{Binding SkipVersionCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="立即更新" Command="{Binding DownloadCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>