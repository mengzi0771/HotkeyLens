<UserControl x:Class="HotkeyLens.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardBorder}" Padding="18,15">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="切换后立即应用到整个应用，并自动保存；重新启动后仍然生效。" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="界面主题" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="跟随系统会读取 Windows 的应用浅色/深色模式。" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource FilterComboBox}"
                                      AutomationProperties.Name="界面主题"
                                      ItemsSource="{Binding Settings.ThemeOptions}" SelectedItem="{Binding Settings.SelectedTheme}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="扫描来源" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="只启用你希望读取的来源。所有来源均为只读，不会修改应用配置。" Style="{StaticResource MutedText}" Margin="0,2,0,12" />

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="快捷方式全局热键" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="读取开始菜单和桌面快捷方式中登记的全局热键，并标注注册证据。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.ScanShortcutFiles}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,9" />

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="应用用户配置" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="读取 VS Code、Windows Terminal、JetBrains IDE 与 Notepad++ 的用户快捷键配置。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.IncludeUserConfigurations}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,9" />

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前窗口菜单（UI Automation）" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="只读取当前已打开窗口中已暴露的菜单项快捷键，不启动应用、不展开菜单、不监听键盘。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.IncludeUiAutomation}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,9" />

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="内置官方快捷键目录" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="展示五个已核实应用的官方默认组合，明确标注为文档来源，不代表你的实际配置。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.IncludeDocumentedCatalog}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,15">
                        <StackPanel>
                            <TextBlock Text="应用范围" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="控制应用发现结果中是否保留部分系统条目。" Style="{StaticResource MutedText}" Margin="0,2,0,11" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="仅注册表发现的应用" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="包含没有开始菜单快捷方式的注册表卸载项。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.IncludeRegistryOnlyApplications}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,9" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows 系统组件" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="包含资源管理器等系统自带组件。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.IncludeSystemApplications}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,15">
                        <StackPanel>
                            <TextBlock Text="扫描限制" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="限制 UI Automation 的等待时间与窗口数量，避免扫描长时间占用。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,11" />
                            <TextBlock Text="单次 UI Automation 超时" Style="{StaticResource FieldLabel}" />
                            <ComboBox Style="{StaticResource FilterComboBox}" Margin="0,5,0,0"
                                      ItemsSource="{Binding Settings.UiTimeoutOptions}" SelectedItem="{Binding Settings.SelectedUiTimeout}" />
                            <TextBlock Text="最多读取的窗口数" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <ComboBox Style="{StaticResource FilterComboBox}" Margin="0,5,0,0"
                                      ItemsSource="{Binding Settings.MaxWindowOptions}" SelectedItem="{Binding Settings.SelectedMaxWindows}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="数据管理" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="扫描结果保存为单个 JSON 快照，不包含键盘输入记录。" Style="{StaticResource MutedText}" Margin="0,2,0,11" />
                        <TextBlock Text="数据目录" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Settings.DataDirectory}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="扫描快照" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Settings.SnapshotPath}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="偏好设置" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Settings.PreferencesPath}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="打开数据目录"
                                    Command="{Binding Settings.OpenDataFolderCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="定位扫描快照"
                                    Command="{Binding Settings.OpenSnapshotCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource DangerButton}" Content="清除扫描数据"
                                    Command="{Binding Settings.ClearDataCommand}" />
                        </StackPanel>
                        <TextBlock Text="清除只删除 scan-snapshot.json，不会删除偏好设置。删除前会再次确认。" Style="{StaticResource CaptionText}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="更新" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="只从官方 GitHub Releases 检查正式版本；自动检查仅发现更新，不会自动下载或安装。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,11" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="自动检查更新" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="启动时检查；距上次成功检查超过 24 小时才再次请求 GitHub API。" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Settings.AutoCheckUpdates}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="当前版本" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Update.CurrentVersionText}" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="运行方式" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Update.ModeLabel}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="上次检查" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Update.LastCheckedText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="跳过的版本" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Update.SkippedVersionText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="发现新版本 " FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Update.LatestVersionText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Update.StatusMessage}" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding Update.StatusMessage, Converter={StaticResource EmptyTextToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="检查更新"
                                    Command="{Binding Update.CheckCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostButton}" Content="打开发布页"
                                    Command="{Binding Update.OpenReleasePageCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostButton}" Content="清除跳过版本"
                                    Command="{Binding Update.ClearSkippedVersionCommand}" />
                        </StackPanel>
                        <TextBlock Text="手动检查始终可用，即使自动检查已关闭。下载通过 HTTPS 进行并校验 SHA256；安装版会启动安装程序覆盖升级，便携版会打开下载位置供你手动替换。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="18,15" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="关于 HotkeyLens" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Discover Every Shortcut." FontFamily="{StaticResource DisplayFontFamily}" FontSize="17"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Settings.VersionText, StringFormat=版本 {0}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,0"
                                   Text="HotkeyLens 是一个按需运行的 Windows 快捷键发现工具。它从应用清单、快捷方式登记、用户配置文件、官方文档和 UI Automation 收集证据，并明确标注每条结果的来源与可信度。Windows 没有可以枚举所有进程全局热键的通用接口，因此这里展示的是可合法读取、可解释来源的信息，而不是系统全部实际绑定。" />
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                   Text="程序不会安装键盘钩子、不会常驻后台、不会开机启动。关闭窗口即退出；扫描只在你主动点击后开始，并可随时取消。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="18,13" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="快捷键管理说明" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"
                                   Text="HotkeyLens 提供跳转到已知设置位置的辅助能力，但不会自动改写第三方应用的快捷键，也不会承诺解除或禁用全局热键。若应用没有可靠、安全的公开配置入口，请按详情中的说明手动修改；修改前建议先备份配置文件。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Settings.StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="11.5"
                               VerticalAlignment="Center"
                               Visibility="{Binding Settings.StatusMessage, Converter={StaticResource EmptyTextToVisibility}}" />
                    <TextBlock Text="{Binding Settings.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding Settings.ErrorMessage, Converter={StaticResource EmptyTextToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="有未保存的更改" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding Settings.IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource GhostButton}" Content="恢复推荐选项"
                            Command="{Binding Settings.ResetOptionsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存设置"
                            Command="{Binding Settings.SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>