<UserControl x:Class="HotkeyLens.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="13,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="全局注册竞争" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding GlobalCompetitions}" FontFamily="{StaticResource MonoFontFamily}" FontSize="24"
                                   FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="有明确注册证据、运行时可能争抢同一组合" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource WarningSoftBrush}" CornerRadius="9" Padding="13,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="潜在冲突" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PotentialConflicts}" FontFamily="{StaticResource MonoFontFamily}" FontSize="24"
                                   FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="作用范围交叠，但缺少足以确认冲突的证据" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="13,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C9;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="重复快捷键" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding DuplicateGroups}" FontFamily="{StaticResource MonoFontFamily}" FontSize="24"
                                   FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="不同应用在各自窗口内使用相同组合，通常不冲突" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="相同按键组合只有在作用范围与注册证据支持时才归类为冲突。" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource FilterComboBox}" Width="190"
                              ItemsSource="{Binding ConflictFilterOptions}" SelectedItem="{Binding SelectedConflictFilter}"
                              ToolTip="按冲突类型筛选" />
                    <TextBlock Text="{Binding ConflictFilterSummary}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="11,11,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid>
                        <TextBlock Text="冲突与重复明细" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="每一条都包含涉及软件、功能、作用范围、判断依据与建议" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="120,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredConflicts}" Margin="12,12,12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding AccentHex}" />
                                            <StackPanel Grid.Column="1" Margin="15,13,15,13">
                                                <DockPanel>
                                                    <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="6" Padding="9,5">
                                                        <TextBlock Text="{Binding GestureText}" FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="12.5" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeBorder}" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding AccentHex}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeBorder}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SeverityLabel, StringFormat=严重度 {0}}" FontSize="10" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeBorder}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConfidenceLabel, StringFormat=可信度 {0}}" FontSize="10" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ParticipantCountText}" Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"
                                                           LineHeight="19" Margin="0,10,0,0" />

                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="7" Margin="0,9,0,0" Padding="10,7">
                                                    <ItemsControl ItemsSource="{Binding Participants}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="180" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="92" />
                                                                        <ColumnDefinition Width="110" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ApplicationName}" FontSize="11" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ActionName}" FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding ScopeLabel}" FontSize="10"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding SourceLabel}" FontSize="10"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <TextBlock Text="判断依据" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                                <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" FontSize="11"
                                                           LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />

                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,7" Margin="0,9,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="建议处理方式" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" FontSize="11"
                                                                   LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Style="{StaticResource GhostButton}" Content="在快捷键列表中定位"
                                                        Command="{Binding DataContext.ShowConflictShortcutsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                        Padding="6,3" MinHeight="24" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoSnapshot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                            <Condition Binding="{Binding HasConflicts}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasConflicts}" Value="True" />
                                            <Condition Binding="{Binding FilteredConflicts.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="26"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="尚未扫描，暂无冲突分析结果。" Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding HasNoSnapshot, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                                <Condition Binding="{Binding HasConflicts}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="本次扫描没有发现需要提示的重复或冲突。" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="没有结果不等于系统中不存在快捷键，只表示已读取的来源里没有可归类的重复证据。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="440"
                                       TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="当前筛选条件下没有冲突记录。"
                                   Margin="0,8,0,0" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasConflicts}" Value="True" />
                                                <Condition Binding="{Binding FilteredConflicts.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>