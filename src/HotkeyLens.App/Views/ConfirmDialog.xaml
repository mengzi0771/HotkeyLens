<Window x:Class="HotkeyLens.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotkeyLens"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Margin="22" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource DialogShadowColor}" BlurRadius="28"
                              ShadowDepth="8" Direction="270" Opacity="0.7" />
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource DangerSoftBrush}">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="DialogTitle" Text="确认操作" FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CancelButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <TextBlock x:Name="DialogMessage" Grid.Row="1" TextWrapping="Wrap" LineHeight="21"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                       Margin="0,18,0,0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="86"
                        Click="CancelButton_Click" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Content="确认"
                        MinWidth="96" Click="ConfirmButton_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>