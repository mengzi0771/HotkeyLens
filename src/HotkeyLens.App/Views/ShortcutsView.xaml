<UserControl x:Class="HotkeyLens.App.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="142" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox Style="{StaticResource SearchTextBox}" Padding="34,0,12,0"
                                 AutomationProperties.Name="搜索快捷键"
                                 Text="{Binding ShortcutSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索按键、应用、功能、描述、来源或上下文" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="搜索快捷键、功能或应用" FontSize="12.5" VerticalAlignment="Center"
                                   Margin="34,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding ShortcutSearchText, Converter={StaticResource EmptyTextToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <ComboBox Grid.Column="2" Style="{StaticResource FilterComboBox}" Width="148"
                              AutomationProperties.Name="按作用范围筛选"
                              ItemsSource="{Binding ShortcutScopeOptions}" SelectedItem="{Binding SelectedShortcutScope}"
                              ToolTip="按作用范围筛选" />
                    <ComboBox Grid.Column="4" Style="{StaticResource FilterComboBox}" Width="168"
                              AutomationProperties.Name="按信息来源筛选"
                              ItemsSource="{Binding ShortcutSourceOptions}" SelectedItem="{Binding SelectedShortcutSource}"
                              ToolTip="按信息来源筛选" />
                    <ComboBox Grid.Column="6" Style="{StaticResource FilterComboBox}" Width="142"
                              AutomationProperties.Name="按识别可信度筛选"
                              ItemsSource="{Binding ShortcutConfidenceOptions}" SelectedItem="{Binding SelectedShortcutConfidence}"
                              ToolTip="按识别可信度筛选" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="排序" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox Style="{StaticResource FilterComboBox}" Width="132"
                                  ItemsSource="{Binding ShortcutSortOptions}" SelectedItem="{Binding SelectedShortcutSort}" />

                        <TextBlock Text="分类" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="15,0,7,0" />
                        <ComboBox Style="{StaticResource FilterComboBox}" Width="138"
                                  ItemsSource="{Binding ShortcutCategoryOptions}" SelectedItem="{Binding SelectedShortcutCategory}" />

                        <TextBlock Text="仅看有冲突" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="18,0,7,0" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding OnlyConflicting}"
                                  ToolTip="只显示参与重复或潜在冲突分析的快捷键" />

                        <TextBlock Text="只看重点热键" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="18,0,7,0" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding OnlyImportantShortcuts}"
                                  ToolTip="默认只显示全局（跨软件生效）热键和 Windows 系统常用热键；关闭后显示软件内部的全部快捷键" />

                        <TextBlock Text="按软件分组" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="18,0,7,0" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding GroupShortcutsByApplication}"
                                  ToolTip="按应用程序分组展示快捷键" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShortcutFilterSummary}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearShortcutFiltersCommand}"
                                Content="清除筛选" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="11,11,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷键" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="应用 / 功能" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="范围" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="冲突" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ShortcutList" ItemsSource="{Binding ShortcutsView}" SelectedItem="{Binding SelectedShortcut}"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RowListBoxItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="6" Padding="9,5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayGesture}" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ApplicationName}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ActionName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ScopeLabel}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource WarningBrush}"
                                                    Visibility="{Binding IsConflicting, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding ConflictCount}" FontSize="10.5" Margin="5,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding IsConflicting, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoSnapshot}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                                <Condition Binding="{Binding FilteredShortcuts.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFontFamily}" FontSize="24"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="尚未扫描，还没有可展示的快捷键。" Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Visibility="{Binding HasNoSnapshot, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="没有快捷键符合当前筛选条件。"
                                       Margin="0,8,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                                    <Condition Binding="{Binding FilteredShortcuts.Count}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="404" Margin="12,0,0,0" Style="{StaticResource CardBorder}" Padding="0"
                    Visibility="{Binding HasSelectedShortcut, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="快捷键详情" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding SelectedShortcut.ApplicationName}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                    Command="{Binding CloseShortcutDetailsCommand}" ToolTip="关闭详情"
                                    AutomationProperties.Name="关闭快捷键详情">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,16,18,20">
                            <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedShortcut.DisplayGesture}" FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="这是一组按键序列，需要依次按下。" Style="{StaticResource CaptionText}"
                                               Margin="0,5,0,0"
                                               Visibility="{Binding SelectedShortcut.IsSequence, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding SelectedShortcut.ActionName}" FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedShortcut.ScopeLabel}" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedShortcut.OriginLabel}" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}">
                                    <TextBlock Text="{Binding SelectedShortcut.ConfidenceLabel, StringFormat=可信度 {0}}" FontSize="10" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedShortcut.Description}" TextWrapping="Wrap" FontSize="12.5"
                                       LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />

                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyShortcutCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6" MinHeight="30" Content="复制按键组合" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14" />

                            <TextBlock Text="识别依据" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SelectedShortcut.SourceLabel}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedShortcut.SourceKindLabel, StringFormat=来源类型：{0}}" Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SelectedShortcut.SourceReference}" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,5,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="打开来源位置" Command="{Binding OpenShortcutSourceCommand}"
                                    HorizontalAlignment="Left" Margin="0,5,0,0"
                                    Visibility="{Binding SelectedShortcut.HasSourceReference, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="可信度依据" Style="{StaticResource FieldLabel}" Margin="0,13,0,0" />
                            <TextBlock Text="{Binding SelectedShortcut.ConfidenceRationale}" TextWrapping="Wrap" FontSize="11.5"
                                       LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="生效上下文" Style="{StaticResource FieldLabel}" Margin="0,13,0,0" />
                            <TextBlock Text="{Binding SelectedShortcut.ContextText}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedShortcut.RawValueText, StringFormat=原始值：{0}}" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,7,0,0"
                                       Visibility="{Binding SelectedShortcut.HasRawValue, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding SelectedShortcut.CapturedAtText, StringFormat=读取时间：{0}}" Style="{StaticResource CaptionText}"
                                       Margin="0,7,0,0" />

                            <TextBlock Text="相关冲突" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding SelectedShortcut.ConflictSummary}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding SelectedShortcut.RelatedConflicts}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,7">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{Binding AccentHex}" />
                                                    <TextBlock Text="{Binding SeverityLabel, StringFormat=严重度 {0}}" FontSize="9.5"
                                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="10.5"
                                                           LineHeight="17" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Button Style="{StaticResource GhostButton}" Content="定位相关快捷键"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,3" MinHeight="24"
                                                        Command="{Binding DataContext.ShowConflictShortcutsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenShortcutSettingsCommand}"
                                    Content="查看该应用的设置位置" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            <TextBlock Text="HotkeyLens 不会改写该应用的配置文件。" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>