<UserControl x:Class="HotkeyLens.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox Style="{StaticResource SearchTextBox}" Padding="34,0,12,0"
                             Text="{Binding ApplicationSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按软件名称、发布者、路径或来源搜索" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                               Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="搜索软件名称、发布者或安装路径" FontSize="12.5" VerticalAlignment="Center"
                               Margin="34,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"
                               Visibility="{Binding ApplicationSearchText, Converter={StaticResource EmptyTextToVisibility}, ConverterParameter=invert}" />
                </Grid>

                <ComboBox Grid.Column="2" Style="{StaticResource FilterComboBox}" Width="168"
                          ItemsSource="{Binding ApplicationCategoryOptions}" SelectedItem="{Binding SelectedApplicationCategory}"
                          ToolTip="按软件分类筛选" />
                <TextBlock Grid.Column="4" Text="{Binding ApplicationFilterSummary}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="11,11,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="应用程序" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="快捷键" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="扫描状态" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ApplicationList" ItemsSource="{Binding ApplicationsView}" SelectedItem="{Binding SelectedApplication}"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RowListBoxItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="8">
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding IconPath, Converter={StaticResource ApplicationIcon}}"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PublisherVersionText}" FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding ShortcutCountText}" FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <Border Grid.Column="3" Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoSnapshot}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                                <Condition Binding="{Binding FilteredApplications.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFontFamily}" FontSize="24"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="尚未扫描，还没有发现应用程序。" Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Visibility="{Binding HasNoSnapshot, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="没有应用程序符合当前筛选条件。"
                                       Margin="0,8,0,0" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSnapshot}" Value="True" />
                                                    <Condition Binding="{Binding FilteredApplications.Count}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="404" Margin="12,0,0,0" Style="{StaticResource CardBorder}" Padding="0"
                    Visibility="{Binding HasSelectedApplication, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="应用详情" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding SelectedApplication.CategoryLabel}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                    Command="{Binding CloseApplicationDetailsCommand}" ToolTip="关闭详情"
                                    AutomationProperties.Name="关闭应用详情">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,16,18,20">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="48" Height="48">
                                    <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="10">
                                        <TextBlock Text="{Binding SelectedApplication.Initial}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding SelectedApplication.IconPath, Converter={StaticResource ApplicationIcon}}"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="280">
                                    <TextBlock Text="{Binding SelectedApplication.Name}" FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedApplication.Publisher}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedApplication.VersionText}" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedApplication.KindLabel}" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}">
                                    <TextBlock Text="{Binding SelectedApplication.SourceLabel}" FontSize="10" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="11,9" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="已识别快捷键" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding SelectedApplication.ShortcutCountText}"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="11,9" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="扫描状态" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding SelectedApplication.StateLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding SelectedApplication.StateDetail}" TextWrapping="Wrap" FontSize="11.5"
                                       LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,15,0,13" />

                            <TextBlock Text="已检查的信息来源" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SelectedApplication.CheckedSourcesText}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="可执行文件" Style="{StaticResource FieldLabel}" Margin="0,13,0,0" />
                            <TextBlock Text="{Binding SelectedApplication.ExecutablePath}" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="打开安装目录" Command="{Binding OpenApplicationFolderCommand}"
                                    HorizontalAlignment="Left" Margin="0,5,0,0" Padding="6,3" MinHeight="24"
                                    Visibility="{Binding SelectedApplication.HasExecutablePath, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="安装位置" Style="{StaticResource FieldLabel}" Margin="0,13,0,0" />
                            <TextBlock Text="{Binding SelectedApplication.InstallLocation}" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="发现来源" Style="{StaticResource FieldLabel}" Margin="0,13,0,0" />
                            <TextBlock Text="{Binding SelectedApplication.SourceDetail}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="快捷键设置位置" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedApplication.SettingsHint}" TextWrapping="Wrap" FontSize="10.5"
                                               LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedApplication.SettingsPath}" FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,5,0,0"
                                               Visibility="{Binding SelectedApplication.HasSettingsPath, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="打开设置位置"
                                            Command="{Binding OpenApplicationSettingsCommand}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Padding="10,5" MinHeight="28" />
                                    <TextBlock Text="仅打开位置供你查看；HotkeyLens 不会修改应用配置。" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="HotkeyLens 不会启动或修改该应用。" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>