<Window x:Class="HotkeyLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:HotkeyLens.App.Views"
        mc:Ignorable="d"
        Title="HotkeyLens — Discover Every Shortcut"
        Width="1400" Height="900" MinWidth="1120" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource WindowChromeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource WindowChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseChromeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource WindowChromeCloseHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowRoot" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource WindowChromeBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                       Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="HotkeyLens" FontFamily="{StaticResource DisplayFontFamily}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource WindowChromeTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Border Width="1" Height="16" Background="{DynamicResource SidebarDividerBrush}" Margin="14,0" />
                        <TextBlock Text="Discover Every Shortcut." FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeButton}" ToolTip="最小化"
                                AutomationProperties.Name="最小化窗口" Click="MinimizeButton_Click">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}"
                                ToolTip="最大化" AutomationProperties.Name="最大化或还原窗口"
                                Click="MaximizeButton_Click">
                            <TextBlock Text="&#xE922;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource CloseChromeButton}" ToolTip="关闭"
                                AutomationProperties.Name="关闭窗口" Click="CloseButton_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 侧边栏 -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource SidebarDividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="14,16,14,8" Padding="12,11" CornerRadius="10"
                            Background="{DynamicResource SidebarCardBackgroundBrush}"
                            BorderBrush="{DynamicResource SidebarCardBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="本机快捷键索引" FontSize="10.5" Foreground="{DynamicResource SidebarMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TotalShortcuts}" FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                                <TextBlock Text=" 条已识别" FontSize="11" Foreground="{DynamicResource SidebarMutedBrush}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <TextBlock Text="{Binding CoverageText}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="导航" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarMutedBrush}" Margin="24,12,0,4" />

                    <ListBox Grid.Row="2" Style="{StaticResource NavListBox}" AutomationProperties.Name="主导航"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="5,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource SidebarDividerBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="按需运行，不驻留后台" FontSize="10.5" Margin="7,0,0,0"
                                           Foreground="{DynamicResource SidebarMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="只在点击扫描时读取系统信息，关闭窗口即退出。"
                                       TextWrapping="Wrap" FontSize="10" LineHeight="16" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SidebarMutedBrush}" Opacity="0.8" />
                            <TextBlock Text="{Binding Settings.VersionText, StringFormat=版本 {0}}" FontSize="9.5"
                                       Margin="0,8,0,0" Foreground="{DynamicResource SidebarMutedBrush}" Opacity="0.6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 主区域 -->
            <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="34,24,34,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HOTKEYLENS / 工作区" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageHeading}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelScanCommand}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,9,0" Content="取消扫描" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                                    AutomationProperties.Name="{Binding ScanButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ScanButtonText}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SoftCardBorder}" Margin="34,0,34,12"
                        Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFontFamily}" FontSize="15"
                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="10,0,12,0">
                            <TextBlock Text="操作提示" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding DismissErrorCommand}" VerticalAlignment="Top" ToolTip="关闭提示"
                                AutomationProperties.Name="关闭错误提示">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="34,0,34,12" Padding="16,13"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ScanPhase}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding ScanMessage}" Style="{StaticResource MutedText}" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ScanPercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Value="{Binding ScanPercent, Mode=OneWay}" Margin="0,9,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="34,0,34,10">
                    <views:DashboardView Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}" />
                    <views:ShortcutsView Visibility="{Binding IsShortcutsVisible, Converter={StaticResource BoolToVisibility}}" />
                    <views:ApplicationsView Visibility="{Binding IsApplicationsVisible, Converter={StaticResource BoolToVisibility}}" />
                    <views:ConflictsView Visibility="{Binding IsConflictsVisible, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="34,6" Height="30" Background="{DynamicResource AppBackgroundBrush}">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource EmptyTextToVisibility}}" />
                        <TextBlock Text="只读扫描 · 最小权限 · 无后台进程" FontSize="10" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>